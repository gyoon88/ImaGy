<Window x:Class="ImaGy.View.GridRoiStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보기 (ROI 통계)"
        Height="320" Width="520"
        MinHeight="240" MinWidth="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10" Background="{StaticResource WindowBackgroundBrush}">
        <GroupBox Header="ROI 통계" Foreground="White">
            <TextBox Text="{Binding SelectedRoiStatsText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="White"/>
        </GroupBox>
    </Grid>
</Window>
