<Window x:Class="ImaGy.View.HistogramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImaGy.View"
        xmlns:vm="clr-namespace:ImaGy.ViewModels"
        mc:Ignorable="d"
        Title="Histogram" Height="400" Width="600"
        d:DataContext="{d:DesignInstance Type=vm:HistogramViewModel, IsDesignTimeCreatable=True}"
        ToolTip="이미지 또는 격자 값 분포 히스토그램">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="10,8,10,4">
            <TextBlock Text="표본" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"
                       ToolTip="픽셀 GV 또는 행/열 방향 밝기 합의 분포"/>
            <ComboBox Width="268" DockPanel.Dock="Left" SelectedIndex="{Binding SampleModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="픽셀 (GV)"/>
                <ComboBoxItem Content="행 합 (X방향 누적)"/>
                <ComboBoxItem Content="열 합 (Y방향 누적)"/>
            </ComboBox>
            <Button Content="라인 프로파일" Click="OpenLineProfile_Click" Margin="12,0,0,0" Padding="12,4" DockPanel.Dock="Left"
                    ToolTip="메인 이미지·분석 ROI를 격자로 열어 행/열 프로파일 (별 창)"/>
        </DockPanel>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="YAxisTitleText" Grid.Row="0" Grid.Column="0" Text="count" 
               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"
               ToolTip="세로축: 빈도(카운트) 또는 행/열 합 모드에서 밝기 합">
            <TextBlock.LayoutTransform>
                <RotateTransform Angle="-90"/>
            </TextBlock.LayoutTransform>
        </TextBlock>
        <!-- Y Axis Labels -->
        <Canvas Grid.Row="0" Grid.Column="1" Name="YAxisLabelsPanel" VerticalAlignment="Stretch" Margin="15,10,5,0"/>

        <!-- Histogram Canvas -->
        <Canvas Grid.Row="0" Grid.Column="2" Name="HistogramCanvas"
                Background="{StaticResource PrimaryGrayBrush}"
                Margin="0,10,0,0"
                SizeChanged="HistogramCanvas_SizeChanged"
                MouseMove="HistogramCanvas_MouseMove"
                MouseLeave="HistogramCanvas_MouseLeave"
                ToolTip="마우스를 올리면 구간(bin) 정보가 아래에 표시됩니다"/>

        <!-- X Axis Labels -->
        <Canvas Grid.Row="1" Grid.Column="2" Name="XAxisLabelsPanel" Height="20" Margin="0,0,0,6"/>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical" Margin="0,0,0,2">
            <TextBlock Text="{Binding XAxisTitle}"
                   Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
            <TextBlock x:Name="HoverInfoText"
                       Text="마우스를 올려 bin 값 확인"
                       Foreground="White" Opacity="0.9"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0"
                       ToolTip="캔버스 위 마우스 위치의 bin 범위·개수"/>
            <CheckBox x:Name="UseLogScaleCheckBox"
                      Content="Y축 로그 스케일"
                      Foreground="White"
                      Margin="0,4,0,0"
                      HorizontalAlignment="Center"
                      Checked="UseLogScaleCheckBox_Changed"
                      Unchecked="UseLogScaleCheckBox_Changed"
                      ToolTip="카운트 축을 로그 스케일로 표시(작은 빈도도 구분하기 쉬움)"/>
        </StackPanel>
        <!-- Statistics Panel -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" BorderBrush="{StaticResource PrimaryGrayBrush}" BorderThickness="1" Margin="10" Padding="10" MinWidth="160"
                ToolTip="표본에 대한 요약 통계">
            <StackPanel>
                <TextBlock Text="Summary Statistics" FontWeight="Bold" Margin="0,0,0,10"  Foreground="White" TextAlignment="Center" ToolTip="평균·표준편차·분위수 등"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mean:" Margin="0,2,5,2" Foreground="White" ToolTip="산술 평균"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Mean, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2" Foreground="White" ToolTip="표본 평균"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Std Dev:" Margin="0,2,5,2" Foreground="White" ToolTip="표준편차"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Std, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2"  Foreground="White" ToolTip="표준편차 값"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Median:" Margin="0,2,5,2"  Foreground="White" ToolTip="중앙값"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Median, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2" Foreground="White" ToolTip="중앙값"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mode:" Margin="0,2,5,2"  Foreground="White" ToolTip="최빈값"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Mode, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2"  Foreground="White" ToolTip="최빈값"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Min:" Margin="0,2,5,2" Foreground="White" ToolTip="최솟값"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Min, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2"  Foreground="White" ToolTip="최솟값"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Max:" Margin="0,2,5,2"  Foreground="White" ToolTip="최댓값"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Max, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2"  Foreground="White" ToolTip="최댓값"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Range:" Margin="0,2,5,2"  Foreground="White" ToolTip="Max − Min"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Range, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2" Foreground="White" ToolTip="범위"/>
                    
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Count:" Margin="0,2,5,2"  Foreground="White" ToolTip="Pixel Count"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Count, StringFormat={}{0:F4}, FallbackValue='N/A'}" HorizontalAlignment="Right" Margin="0,2" Foreground="White" ToolTip="픽셀 갯수"/>
                    </Grid>
            </StackPanel>
        </Border>

        </Grid>
    </Grid>
</Window>