<Window x:Class="ImaGy.View.GridRoiHypothesisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Diff ROI 2그룹 검정" Height="520" Width="640"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ToolTip="현재 Diff 격자에서 두 ROI의 유한 값에 대해 t·Welch·ANOVA·Mann–Whitney를 계산합니다.">
    <Grid Margin="14" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"
                   Text="CSV 워크벤치의 Diff 격자와 그려 둔 ROI 중 서로 다른 두 개를 선택합니다. 동일한 격자 셀을 두 ROI가 동시에 쓰면 값이 겹칠 수 있으니 ROI는 겹치지 않게 그리는 것이 좋습니다."/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="그룹 1 ROI" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding RoiChoices}" SelectedItem="{Binding RoiGroup1, Mode=TwoWay}"
                          DisplayMemberPath="Name" Margin="0,4,0,0" MinHeight="28"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="그룹 2 ROI" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding RoiChoices}" SelectedItem="{Binding RoiGroup2, Mode=TwoWay}"
                          DisplayMemberPath="Name" Margin="0,4,0,0" MinHeight="28"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="검정 결과" Foreground="{StaticResource TextBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                         Background="{StaticResource PrimaryGrayBrush}" BorderThickness="0"/>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="검정 실행" Command="{Binding RunTestsCommand}" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="닫기" Padding="16,6" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
