<Window x:Class="ImaGy.View.GridWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CSV 2D 격자 워크벤치" Height="780" Width="1100"
        ToolTip="CSV 격자 정렬·Diff·ROI·배치 워크벤치">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="10,10,10,8">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_파일" ToolTip="CSV 열기·저장·내보내기">
                    <MenuItem Header="CSV A 열기" Command="{Binding OpenCsvACommand}" ToolTip="CSV A 열기"/>
                    <MenuItem Header="CSV B 열기" Command="{Binding OpenCsvBCommand}" ToolTip="CSV B 열기"/>
                    <MenuItem Header="Diff CSV 열기" Command="{Binding OpenDiffCsvCommand}" ToolTip="Diff CSV 단독 열기"/>
                    <MenuItem Header="ROI JSON 불러오기" Command="{Binding LoadRoiJsonCommand}" ToolTip="ROI JSON 불러오기"/>
                    <Separator />
                    <MenuItem Header="Diff CSV 저장" Command="{Binding SaveDiffCsvCommand}" ToolTip="Diff CSV 저장"/>
                    <MenuItem Header="히트맵 PNG 저장" Command="{Binding SaveHeatmapsCommand}" ToolTip="A/B/Diff 히트맵 PNG 저장"/>
                    <MenuItem Header="ScottPlot 저장" Command="{Binding SaveScottPlotCommand}" ToolTip="ScottPlot PNG 저장"/>
                </MenuItem>

                <MenuItem Header="_편집" ToolTip="ROI 편집">
                    <MenuItem Header="ROI 추가/갱신" Click="AddOrUpdateRoi_Click" ToolTip="현재 ROI를 목록에 추가/갱신"/>
                    <MenuItem Header="선택 ROI 삭제" Click="RemoveSelectedRoi_Click" ToolTip="선택 ROI 삭제"/>
                    <MenuItem Header="ROI 오버레이 지우기" Click="ClearRoiOverlay_Click" ToolTip="화면/목록 ROI 전체 삭제"/>
                    <MenuItem Header="ROI JSON으로 저장" Click="SaveRoiJson_Click" ToolTip="현재 ROI 목록을 JSON으로 저장"/>
                </MenuItem>

                <MenuItem Header="_보기" ToolTip="보조 창">
                    <MenuItem Header="히스토그램" Command="{Binding OpenHistogramCommand}" ToolTip="현재 Diff/ROI 히스토그램"/>
                    <MenuItem Header="라인 프로파일" Click="OpenLineProfile_Click" ToolTip="현재 Diff/ROI 라인 프로파일"/>
                    <Separator />
                    <MenuItem Header="ROI 통계 창" Click="OpenRoiStatsWindow_Click" ToolTip="선택 ROI 통계 전용 창"/>
                </MenuItem>

                <MenuItem Header="_도구" ToolTip="실행 도구">
                    <MenuItem Header="파이프라인 실행" Command="{Binding RunPipelineCommand}" ToolTip="A/B 파이프라인 실행"/>
                    <MenuItem Header="Diff 표시 적용" Command="{Binding ApplyDiffPreviewCommand}" ToolTip="Diff 표시 옵션 반영"/>
                    <MenuItem Header="Diff ROI 2그룹 검정 (t·Welch·MWU·ANOVA)" Click="OpenRoiHypothesis_Click"
                              ToolTip="Diff 격자에서 ROI 두 개를 골라 등분산 t, Welch t, 일원 ANOVA(F), Mann–Whitney(정규 근사)를 계산합니다."/>
                    <Separator />
                    <MenuItem Header="출력 폴더 선택" Command="{Binding PickOutputFolderCommand}" ToolTip="출력 폴더 선택"/>
                </MenuItem>

                <MenuItem Header="_배치" ToolTip="여러 CSV 처리">
                    <MenuItem Header="배치 창 열기" Click="OpenBatchWindow_Click" ToolTip="배치 자동화 전용 창"/>
                    <Separator />
                    <MenuItem Header="배치 폴더 선택" Command="{Binding PickBatchFolderCommand}" ToolTip="Distance1/2 페어 폴더 선택"/>
                    <MenuItem Header="배치 ROI JSON 선택" Command="{Binding PickBatchCatalogJsonCommand}" ToolTip="배치 ROI 카탈로그 선택(선택)"/>
                    <MenuItem Header="요약 CSV 경로 선택" Command="{Binding PickSummarizeOutCsvCommand}" ToolTip="요약 CSV 저장 경로 선택"/>
                    <Separator />
                    <MenuItem Header="배치 실행" Command="{Binding RunBatchFolderCommand}" ToolTip="폴더 내 페어 일괄 처리"/>
                    <MenuItem Header="Diff CSV들 ROI 요약" Command="{Binding SummarizeDiffsCommand}" ToolTip="기존 diff CSV들 ROI 통계 요약"/>
                </MenuItem>

                <MenuItem Header="_도움말" ToolTip="도움말">
                    <MenuItem Header="워크벤치 도움말 창" Click="OpenHelpWindow_Click" ToolTip="조작 방법 요약 창"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="420" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MinWidth="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="A (미리보기)" Grid.Row="0" Margin="0,0,0,4"
                              ToolTip="정렬·전처리 후 격자 A의 히트맵 미리보기입니다.">
                        <Border Background="{StaticResource PrimaryGrayBrush}" Padding="2">
                            <Image Source="{Binding PreviewA}" Stretch="Uniform" SnapsToDevicePixels="True" ToolTip="격자 A 미리보기"/>
                        </Border>
                    </GroupBox>
                    <GroupBox Header="B (미리보기)" Grid.Row="1" Margin="0,4,0,0"
                              ToolTip="정렬·전처리 후 격자 B의 히트맵 미리보기입니다.">
                        <Border Background="{StaticResource PrimaryGrayBrush}" Padding="2">
                            <Image Source="{Binding PreviewB}" Stretch="Uniform" SnapsToDevicePixels="True" ToolTip="격자 B 미리보기"/>
                        </Border>
                    </GroupBox>
                </Grid>
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="{StaticResource SecondaryGrayBrush}"
                              ShowsPreview="True"
                              ToolTip="A/B 미리보기 열과 Diff 뷰 사이 폭을 조절합니다."/>
                <GroupBox Grid.Column="2" Header="Diff ROI (휠 확대·가운데 드래그 팬, ROI: Shift+좌클릭)" Margin="0,0,0,0"
                          ToolTip="Diff 격자와 ROI. 휠 확대/축소, 가운데 버튼 드래그로 팬, 도구 선택 후 Shift+좌클릭(드래그)로 ROI.">
                    <Border Background="{StaticResource PrimaryGrayBrush}" Padding="2" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          x:Name="DiffScrollViewer"
                                          Background="{StaticResource PrimaryGrayBrush}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="DiffScrollViewer_PreviewMouseWheel"
                                          PreviewMouseDown="DiffScrollViewer_PreviewMouseDown"
                                          PreviewMouseMove="DiffScrollViewer_PreviewMouseMove"
                                          PreviewMouseUp="DiffScrollViewer_PreviewMouseUp"
                                          ToolTip="휠: 확대/축소, 가운데: 팬(드래그), Shift+좌클릭: ROI(도구 선택 시)">
                                <Grid x:Name="DiffHostGrid" MinHeight="80">
                                    <Image x:Name="DiffPreviewImage"
                                           Source="{Binding PreviewDiff}"
                                           Stretch="None"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           SnapsToDevicePixels="True"
                                           SizeChanged="DiffPreviewImage_SizeChanged"
                                           ToolTip="Diff 격자 픽셀 이미지">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="DiffZoomTransform" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                    <Canvas x:Name="RoiOverlayCanvas"
                                            Panel.ZIndex="1"
                                            Background="Transparent"
                                            IsHitTestVisible="True"
                                            MouseLeftButtonDown="RoiOverlay_MouseLeftButtonDown"
                                            MouseMove="RoiOverlay_MouseMove"
                                            MouseLeave="RoiOverlay_MouseLeave"
                                            MouseLeftButtonUp="RoiOverlay_MouseLeftButtonUp"
                                            MouseRightButtonDown="RoiOverlay_MouseRightButtonDown"
                                            ToolTip="도구 선택 후 Shift+좌클릭(드래그: 사각/원, 3클릭: 삼각). 우클릭: 삼각 취소"/>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DiffCursorInfo}"
                                       Foreground="White"
                                       FontSize="10"
                                       Margin="4,4,4,0"
                                       ToolTip="커서 아래 격자 값·정규화 읽기"/>
                        </Grid>
                    </Border>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource SecondaryGrayBrush}"
                          ShowsPreview="True"
                          ToolTip="메인 뷰와 설정 패널 사이 폭을 조절합니다."/>

            <!-- 메인창처럼 DockPanel로 분리 -->
            <DockPanel Grid.Column="2" Margin="0,0,0,0" >

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ToolTip="파이프라인·표시·ROI 옵션을 펼쳐 설정합니다.">
                    <GroupBox Header="워크벤치 설정" Foreground="White"
                              ToolTip="파이프라인 파라미터, Diff 표시, ROI 옵션입니다.">
                        <StackPanel>
                            <Expander Header="입력 / 경로" IsExpanded="False" Margin="0,4,0,4" Foreground="White"
                                      ToolTip="현재 열린 파일 경로를 표시합니다.">
                                <Border BorderBrush="{StaticResource PrimaryGrayBrush}" BorderThickness="1" Margin="0,6,0,0" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="CSV A" FontSize="11" Foreground="White" Opacity="0.9" Margin="0,0,0,2"
                                                   ToolTip="격자 A로 사용 중인 CSV 경로"/>
                                        <TextBlock Text="{Binding PathA}" TextWrapping="Wrap" FontSize="11" Foreground="White"
                                                   ToolTip="{Binding PathA}"/>
                                        <TextBlock Text="CSV B" FontSize="11" Foreground="White" Opacity="0.9" Margin="0,8,0,2"
                                                   ToolTip="격자 B로 사용 중인 CSV 경로"/>
                                        <TextBlock Text="{Binding PathB}" TextWrapping="Wrap" FontSize="11" Foreground="White"
                                                   ToolTip="{Binding PathB}"/>
                                        <TextBlock Text="Diff CSV (단독)" FontSize="11" Foreground="White" Opacity="0.9" Margin="0,8,0,2"
                                                   ToolTip="A/B 없이 Diff CSV만 열었을 때의 경로"/>
                                        <TextBlock Text="{Binding PathDiff}" TextWrapping="Wrap" FontSize="10" Foreground="White"
                                                   ToolTip="{Binding PathDiff}"/>
                                        <TextBlock Text="ROI JSON" FontSize="11" Foreground="White" Opacity="0.9" Margin="0,10,0,2"
                                                   ToolTip="불러온 ROI 카탈로그 JSON 경로"/>
                                        <TextBlock Text="{Binding RoiJsonPath}" TextWrapping="Wrap" FontSize="10" Foreground="White"
                                                   ToolTip="{Binding RoiJsonPath}"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <Expander Header="Diff 표시 (범위·히트맵/그레이)" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="미리보기 Diff 이미지의 색 스케일과 컬러맵을 바꿉니다.">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="표시 방식" Foreground="White" ToolTip="히트맵(컬러맵) 또는 단일 채널 그레이스케일"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding DiffPreviewMode, Mode=TwoWay}" Margin="0,2"
                                              ToolTip="Diff 미리보기를 컬러 히트맵으로 볼지, 그레이스케일로 볼지 선택합니다.">
                                        <ComboBoxItem Content="히트맵" ToolTip="컬러맵 적용"/>
                                        <ComboBoxItem Content="그레이스케일" ToolTip="단일 채널 밝기로 표시"/>
                                    </ComboBox>
                                    <TextBlock Text="표시 vmin (빈칸=자동)" Margin="0,6,0,0" Foreground="White" FontSize="11"
                                               ToolTip="표시 하한. 비우면 데이터/파이프라인 기준 자동"/>
                                    <TextBox Text="{Binding DiffDisplayMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                             ToolTip="Diff 정규화 최소값. vmax와 함께 숫자로 지정하면 해당 구간으로 클립·스케일합니다."/>
                                    <TextBlock Text="표시 vmax (빈칸=자동)" Margin="0,6,0,0" Foreground="White" FontSize="11"
                                               ToolTip="표시 상한"/>
                                    <TextBox Text="{Binding DiffDisplayMaxText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                             ToolTip="Diff 정규화 최대값"/>
                                    <TextBlock Text="Diff 컬러맵 id (히트맵 전용)" Margin="0,6,0,0" Foreground="White" FontSize="11"
                                               ToolTip="GridColormapCatalog에 등록된 컬러맵 식별자"/>
                                    <TextBox Text="{Binding CmapDiff, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                             ToolTip="히트맵 모드에서 사용할 컬러맵 이름"/>
                                    <Button Content="Diff 표시 적용" Command="{Binding ApplyDiffPreviewCommand}" Margin="0,8,0,0"
                                            ToolTip="vmin/vmax·모드·컬러맵 설정을 Diff 미리보기에 반영합니다."/>
                                    <!--<TextBlock TextWrapping="Wrap" FontSize="10" Foreground="White" Opacity="0.8" Margin="0,6,0,0"
                                               Text="vmin/vmax를 둘 다 숫자로 넣으면 그 구간으로 정규화합니다. 비우면 파이프라인/데이터 기준 자동 범위입니다."/>-->
                                </StackPanel>
                            </Expander>

                            <Expander Header="Diff ROI 그리기" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="Diff 위에서 Shift+좌클릭으로 그립니다(메인 분석 ROI와 동일). 목록·히스토그램 마스크에 사용됩니다.">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="도구" Foreground="White" Margin="0,0,0,4" ToolTip="ROI 도형 종류"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding RoiDrawTool, Mode=TwoWay}" Margin="0,2"
                                              ToolTip="모든 도구: Diff 위에서 Shift+사용. 사각/원: 드래그, 삼각: 점 3회 클릭">
                                        <ComboBoxItem Content="없음" ToolTip="그리기 비활성"/>
                                        <ComboBoxItem Content="사각형" ToolTip="Shift+좌클릭으로 대각 드래그"/>
                                        <ComboBoxItem Content="원" ToolTip="Shift+좌클릭으로 대각 드래그"/>
                                        <ComboBoxItem Content="삼각형" ToolTip="Shift+좌클릭으로 꼭짓점 3회"/>
                                    </ComboBox>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="White" Opacity="0.85" Margin="0,8,0,0"
                                               Text="사각·원: Shift+드래그. 삼각: Shift+클릭 3점. 우클릭: 삼각 진행 취소."/>
                                    <TextBlock Text="ROI 이름" Foreground="White" Margin="0,8,0,2" ToolTip="추가·갱신 시 사용할 레이블"/>
                                    <TextBox Text="{Binding NewRoiName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                             ToolTip="목록에 표시될 ROI 이름"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="ROI 추가/갱신" Width="118" Margin="0,0,6,0" Click="AddOrUpdateRoi_Click"
                                                ToolTip="이름이 같으면 갱신, 없으면 목록에 추가"/>
                                        <Button Content="선택 ROI 삭제" Width="118" Click="RemoveSelectedRoi_Click"
                                                ToolTip="목록에서 선택한 ROI 제거"/>
                                    </StackPanel>
                                    <TextBlock Text="ROI 목록" Foreground="White" Margin="0,8,0,2" ToolTip="다중 ROI 중 선택"/>
                                    <ListBox ItemsSource="{Binding DrawnRois}"
                                             SelectedItem="{Binding SelectedRoi, Mode=TwoWay}"
                                             DisplayMemberPath="Name"
                                             MinHeight="120"
                                             MaxHeight="180"
                                             ToolTip="선택한 ROI가 히스토그램·통계에 적용됩니다. 없으면 전체 마스크"/>
                                    <Button Content="ROI 오버레이 지우기(전체)" Margin="0,8,0,0" Click="ClearRoiOverlay_Click"
                                            ToolTip="화면과 목록의 모든 ROI를 지웁니다"/>
                                    <Button Content="ROI JSON으로 저장" Margin="0,6,0,0" Click="SaveRoiJson_Click"
                                            ToolTip="현재 ROI 목록을 카탈로그 JSON으로 내보냅니다"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="파이프라인 — 정렬" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="A/B 격자 크기·해상도를 맞추는 방식">
                                <StackPanel Margin="0,6,0,0">
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding AlignmentMode, Mode=TwoWay}" Margin="0,2"
                                              ToolTip="Crop: 작은 쪽에 맞춤, Pad: 큰 쪽에 맞춤, Resample: 보간으로 리샘플">
                                        <ComboBoxItem Content="Crop" ToolTip="공통 영역만 남김"/>
                                        <ComboBoxItem Content="Pad" ToolTip="짧은 쪽을 패딩"/>
                                        <ComboBoxItem Content="Resample" ToolTip="목표 격자에 보간"/>
                                    </ComboBox>
                                    <TextBlock Text="PadPlacement" Margin="0,6,0,0" Foreground="White" ToolTip="패딩을 붙이는 기준 위치"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding PadPlacement, Mode=TwoWay}" Margin="0,2"
                                              ToolTip="Pad 모드에서 원본을 어느 모서리/중앙에 둘지">
                                        <ComboBoxItem Content="TopLeft"/>
                                        <ComboBoxItem Content="Center"/>
                                    </ComboBox>
                                    <TextBlock Text="ResampleRef" Margin="0,6,0,0" Foreground="White" ToolTip="리샘플 시 기준이 되는 격자"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding ResampleRef, Mode=TwoWay}" Margin="0,2">
                                        <ComboBoxItem Content="GridA" ToolTip="A의 행/열 수에 맞춤"/>
                                        <ComboBoxItem Content="GridB" ToolTip="B의 행/열 수에 맞춤"/>
                                    </ComboBox>
                                    <TextBlock Text="Interpolation" Margin="0,6,0,0" Foreground="White" ToolTip="리샘플 보간"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Interpolation, Mode=TwoWay}" Margin="0,2">
                                        <ComboBoxItem Content="Linear"/>
                                        <ComboBoxItem Content="Cubic"/>
                                    </ComboBox>
                                </StackPanel>
                            </Expander>

                            <Expander Header="파이프라인 — 전처리" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="결측·이상치 처리 및 채우기 순서">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="순서" Foreground="White" ToolTip="Fill과 Outlier 필터 적용 순서"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding PreOrder, Mode=TwoWay}" Margin="0,2">
                                        <ComboBoxItem Content="FillThenFilter"/>
                                        <ComboBoxItem Content="FilterThenFill"/>
                                    </ComboBox>
                                    <TextBlock Text="Fill" Margin="0,6,0,0" Foreground="White" ToolTip="결측 셀 채우기 방식"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding FillMethod, Mode=TwoWay}" Margin="0,2">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="ConvolutionMean"/>
                                        <ComboBoxItem Content="LinearInterpolate1D"/>
                                    </ComboBox>
                                    <TextBlock Text="Outlier" Margin="0,6,0,0" Foreground="White" ToolTip="이상치 탐지·처리"/>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding OutlierMethod, Mode=TwoWay}" Margin="0,2">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="IqrTukey"/>
                                        <ComboBoxItem Content="NSigma"/>
                                    </ComboBox>
                                    <TextBlock Text="Conv 창(홀수)" Margin="0,6,0,0" Foreground="White" ToolTip="합성곱 평균 창 크기(홀수)"/>
                                    <TextBox Text="{Binding ConvWindowText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                    <TextBlock Text="Fill 반복" Margin="0,6,0,0" Foreground="White" ToolTip="채우기 반복 횟수"/>
                                    <TextBox Text="{Binding FillIterationsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="파이프라인 — 결합" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="A와 B를 빼기/더하기 및 마스크 규칙">
                                <StackPanel Margin="0,6,0,0">
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding CombineOp, Mode=TwoWay}" Margin="0,2"
                                              ToolTip="Subtract: A−B, Add: A+B">
                                        <ComboBoxItem Content="Subtract"/>
                                        <ComboBoxItem Content="Add"/>
                                    </ComboBox>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding MaskRule, Mode=TwoWay}" Margin="0,6,0,0"
                                              ToolTip="유효 픽셀 마스크 규칙">
                                        <ComboBoxItem Content="BothValid"/>
                                        <ComboBoxItem Content="OriginalOverlap"/>
                                    </ComboBox>
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding DiffPresentation, Mode=TwoWay}" Margin="0,6,0,0"
                                              ToolTip="Diff 부호·절댓값 표현">
                                        <ComboBoxItem Content="Signed"/>
                                        <ComboBoxItem Content="Abs"/>
                                        <ComboBoxItem Content="PositiveOnly"/>
                                        <ComboBoxItem Content="NegativeOnly"/>
                                    </ComboBox>
                                    <CheckBox Content="Signed 대칭 vmin/vmax" IsChecked="{Binding SymmetricSigned}" Margin="0,8,0,0"
                                              ToolTip="Signed 모드에서 색 범위를 0 기준 대칭으로 맞춤"/>
                                    <TextBlock Text="클립 min (빈칸=없음)" Margin="0,6,0,0" Foreground="White"/>
                                    <TextBox Text="{Binding ClipMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                    <TextBlock Text="클립 max" Margin="0,6,0,0" Foreground="White"/>
                                    <TextBox Text="{Binding ClipMaxText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="입력 A/B 컬러맵" IsExpanded="False" Margin="0,0,0,4" Foreground="White"
                                      ToolTip="A/B 미리보기 히트맵에 쓸 컬러맵">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="입력 A/B 히트맵 id" Foreground="White"/>
                                    <TextBox Text="{Binding CmapInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>

            </DockPanel>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="100" Background="#AA000000"
                Visibility="{Binding IsGridBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="{Binding GridBusyStatus}" Foreground="White" FontSize="15" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                <ProgressBar IsIndeterminate="True" Height="22" Width="320"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
