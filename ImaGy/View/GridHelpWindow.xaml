<Window x:Class="ImaGy.View.GridHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="도움말"
        Height="260" Width="520"
        MinHeight="220" MinWidth="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10" Background="{StaticResource WindowBackgroundBrush}">
        <TextBox IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="White"
                 Text="Diff: 휠 확대/축소, 가운데 버튼 드래그 팬.

ROI: Shift+좌클릭으로 그리기 (사각/원은 드래그, 삼각은 3클릭).

히스토그램/라인프로파일은 보기 메뉴에서 열 수 있습니다.

배치 자동화는 배치 메뉴 또는 배치 창에서 실행합니다."/>
    </Grid>
</Window>
