<Window x:Class="ImaGy.View.LineProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImaGy.ViewModels"
        mc:Ignorable="d"
        Title="라인 프로파일" Height="460" Width="860"
        d:DataContext="{d:DesignInstance Type=vm:LineProfileViewModel, IsDesignTimeCreatable=False}"
        ToolTip="분석 ROI 격자에서 한 축을 따라 다른 축 방향 셀 값의 합(라인썸)">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,10,10,8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="모드" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="가로 축(그래프)이 나타낼 ROI 인덱스"/>
                <ComboBox Width="100" SelectedValuePath="Content" SelectedValue="{Binding AxisMode, Mode=TwoWay}" Margin="0,0,10,0"
                          ToolTip="Row: y(행)마다 x방향 합, Column: x(열)마다 y방향 합">
                    <ComboBoxItem Content="Row" ToolTip="가로 축 = ROI y(행) 인덱스 0..H-1, 곡선 값 = 그 행에 대한 x(열) 누적 합"/>
                    <ComboBoxItem Content="Column" ToolTip="가로 축 = ROI x(열) 인덱스 0..W-1, 곡선 값 = 그 열에 대한 y(행) 누적 합"/>
                </ComboBox>
                <TextBlock Text="{Binding Mean, StringFormat=유한 수 평균 {0:F4}}" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="곡선에서 NaN·무한 제외한 평균"/>
            </StackPanel>
            <TextBlock Text="{Binding AxisAbscissaDescription}"
                       Foreground="#FFCCCCCC"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       ToolTip="이 창의 가로축 = ROI 안에서의 (행 또는 열) 0부터 시작하는 인덱스"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="10,0,10,6" BorderBrush="{StaticResource PrimaryGrayBrush}" BorderThickness="1" Background="{StaticResource PrimaryGrayBrush}"
                ToolTip="프로파일 곡선. 마우스를 올리면 좌표·값 표시">
            <Canvas x:Name="ProfileCanvas"
                    SizeChanged="ProfileCanvas_SizeChanged"
                    MouseMove="ProfileCanvas_MouseMove"
                    MouseLeave="ProfileCanvas_MouseLeave"
                    ToolTip="캔버스 위에서 세부 값 확인"/>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="ProfileHoverText"
                   Margin="10,0,10,10"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   Text="마우스를 올려 라인 값 확인"
                   ToolTip="호버 시 인덱스·값 텍스트"/>
    </Grid>
</Window>
