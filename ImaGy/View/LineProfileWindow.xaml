<Window x:Class="ImaGy.View.LineProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImaGy.ViewModels"
        mc:Ignorable="d"
        Title="라인 프로파일" Height="460" Width="860"
        d:DataContext="{d:DesignInstance Type=vm:LineProfileViewModel, IsDesignTimeCreatable=False}"
        ToolTip="한 행 또는 한 열의 값을 선 그래프로 표시">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,8" VerticalAlignment="Center">
            <TextBlock Text="축" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="프로파일 방향"/>
            <ComboBox Width="100" SelectedValuePath="Content" SelectedValue="{Binding AxisMode, Mode=TwoWay}" Margin="0,0,10,0"
                      ToolTip="Row: 가로 한 줄, Column: 세로 한 열">
                <ComboBoxItem Content="Row" ToolTip="고정 행 인덱스, 열 방향으로 값 나열"/>
                <ComboBoxItem Content="Column" ToolTip="고정 열 인덱스, 행 방향으로 값 나열"/>
            </ComboBox>
            <TextBlock Text="{Binding IndexLabel}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="현재 선택한 행/열 번호"/>
            <Slider Width="380"
                    Minimum="0"
                    Maximum="{Binding MaxIndex}"
                    Value="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ToolTip="행/열 인덱스 빠르게 이동"/>
            <TextBox Width="70"
                     Margin="8,0,0,0"
                     Text="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="인덱스 직접 입력"/>
            <TextBlock Text="{Binding Mean, StringFormat=평균 {0:F4}}" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="현재 라인의 평균 값"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="10,0,10,6" BorderBrush="{StaticResource PrimaryGrayBrush}" BorderThickness="1" Background="{StaticResource PrimaryGrayBrush}"
                ToolTip="프로파일 곡선. 마우스를 올리면 좌표·값 표시">
            <Canvas x:Name="ProfileCanvas"
                    SizeChanged="ProfileCanvas_SizeChanged"
                    MouseMove="ProfileCanvas_MouseMove"
                    MouseLeave="ProfileCanvas_MouseLeave"
                    ToolTip="캔버스 위에서 세부 값 확인"/>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="ProfileHoverText"
                   Margin="10,0,10,10"
                   HorizontalAlignment="Center"
                   Foreground="White"
                   Text="마우스를 올려 라인 값 확인"
                   ToolTip="호버 시 인덱스·값 텍스트"/>
    </Grid>
</Window>
